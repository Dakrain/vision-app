<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Mac App Store: the app runs in the sandbox -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.application-identifier</key>
    <string>665S2M698Q.com.vision20.app</string>
    <key>com.apple.developer.team-identifier</key>
    <string>665S2M698Q</string>
    <!-- Electron's processes talk through this group -->
    <key>com.apple.security.application-groups</key>
    <array>
      <string>665S2M698Q.com.vision20.app</string>
    </array>
    <!-- API, Firebase, Agora -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Calls and meetings -->
    <key>com.apple.security.device.camera</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- Files sent in chat (picked), saved recordings (save panel) -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <!-- Attachments downloaded from chat -->
    <key>com.apple.security.files.downloads.read-write</key>
    <true/>
    <!-- Recordings go to ~/Movies/Vision20 by default -->
    <key>com.apple.security.assets.movies.read-write</key>
    <true/>
  </dict>
</plist>
